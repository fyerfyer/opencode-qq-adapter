{
  "name": "@opencode-qq/roleplay",
  "version": "0.4.1",
  "description": "Character-card roleplay plugin for opencode-qq-adapter",
  "type": "module",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "ui/",
    "examples/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "opencodeQq": {
    "id": "roleplay",
    "name": "Roleplay",
    "version": "0.4.1",
    "apiVersion": 1,
    "description": "Character Card V2/V3 roleplay with worldbook recursion, Jev-routed emotion stickers, Markdown memory and raw transcript retrieval",
    "capabilities": [
      "commands",
      "hooks",
      "messages",
      "sessions",
      "agent",
      "admin"
    ],
    "engines": {
      "opencodeQq": ">=0.1.0 <0.3.0"
    },
    "entry": "./dist/index.js",
    "ui": {
      "root": "ui",
      "entry": "index.html"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:ui",
    "build:ui": "vite build --config ui-src/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui-src/tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@character-foundry/character-foundry": "^0.6.0",
    "@opencode-qq/memory": "workspace:*",
    "@opencode-qq/plugin-sdk": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@opencode-qq/plugin-ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "diff": "^9.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^20.1.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.11"
  }
}
