{
  "name": "@opencode-qq/roleplay",
  "version": "0.4.0",
  "description": "Character-card roleplay plugin for opencode-qq-adapter",
  "type": "module",
  "license": "MIT",
  "private": false,
  "files": [
    "dist/",
    "examples/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "opencodeQq": {
    "id": "roleplay",
    "name": "Roleplay",
    "version": "0.4.0",
    "apiVersion": 1,
    "description": "Character Card V2/V3 roleplay with worldbook recursion, Jev-routed emotion stickers, Markdown memory and raw transcript retrieval",
    "capabilities": [
      "commands",
      "hooks",
      "messages",
      "sessions",
      "agent",
      "admin"
    ],
    "engines": {
      "opencodeQq": ">=0.1.0 <0.3.0"
    },
    "entry": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@character-foundry/character-foundry": "^0.6.0",
    "@opencode-qq/memory": "workspace:*",
    "@opencode-qq/plugin-sdk": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.11"
  }
}
