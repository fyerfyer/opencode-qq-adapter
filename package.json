{
  "name": "opencode-qq-adapter",
  "version": "0.1.1",
  "description": "Bridge OpenCode to QQ through NapCat / OneBot 11",
  "type": "module",
  "private": false,
  "license": "MIT",
  "files": [
    "dist/",
    "plugin/",
    "config/config.example.yaml",
    "deploy/",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyerfyer/opencode-qq-adapter.git"
  },
  "homepage": "https://github.com/fyerfyer/opencode-qq-adapter#readme",
  "bugs": {
    "url": "https://github.com/fyerfyer/opencode-qq-adapter/issues"
  },
  "engines": {
    "node": ">=22.11"
  },
  "packageManager": "pnpm@10.26.1",
  "bin": {
    "opencode-qq": "./dist/main.js"
  },
  "keywords": [
    "opencode",
    "qq",
    "qq-bot",
    "napcat",
    "onebot",
    "onebot11",
    "coding-agent"
  ],
  "scripts": {
    "predev": "pnpm build:sdk && pnpm build:roleplay && node scripts/ensure-config.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx watch src/main.ts start --config config/config.yaml",
    "setup": "tsx src/main.ts setup --config config/config.yaml",
    "prestart": "pnpm build:sdk && pnpm build:roleplay && node scripts/ensure-config.mjs",
    "build": "pnpm build:webui && tsc -p tsconfig.json && pnpm build:sdk && pnpm build:roleplay",
    "build:sdk": "pnpm --dir packages/plugin-sdk build",
    "build:roleplay": "pnpm --dir packages/roleplay build",
    "build:webui": "pnpm --dir packages/webui build",
    "build:server": "tsc -p tsconfig.json",
    "dev:webui": "pnpm --dir packages/webui dev",
    "start": "node dist/main.js start --config config/config.yaml",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir packages/webui typecheck && pnpm typecheck:roleplay && pnpm typecheck:examples",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:roleplay": "pnpm --dir packages/roleplay typecheck",
    "typecheck:examples": "pnpm build:sdk && tsc -p examples/tsconfig.json",
    "typecheck:plugin": "tsc -p plugin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:qq": "tsx scripts/e2e-qq.ts",
    "test:qq:media": "tsx scripts/e2e-qq-media.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor": "tsx src/main.ts doctor --config config/config.yaml",
    "config:validate": "tsx src/main.ts config validate --config config/config.yaml"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@opencode/client": "2.0.32",
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.2",
    "hono": "^4.10.4",
    "node-napcat-ts": "0.4.25",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "semver": "^7.7.3",
    "ulid": "^3.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@character-foundry/character-foundry": "^0.6.0",
    "@opencode-ai/plugin": "^1.19.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.12",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4",
    "ws": "^8.18.3"
  }
}
