# `opencode-qq setup` generates this file with random tokens.
# This example is for manual/source installs.
#
# NapCat forward WebSocket endpoint (the bridge connects to NapCat).
NAPCAT_WS_URL=ws://127.0.0.1:3001

# OneBot / NapCat access token. Must match the token configured in NapCat.
NAPCAT_ACCESS_TOKEN=change-me

# Token used by the local plugin callback endpoint (qq_send_image).
QQ_BRIDGE_INTERNAL_TOKEN=change-me-too

# Optional owner 2FA for bridge-side dangerous commands. Base32 TOTP secret.
# QQ_ADMIN_TOTP_SECRET=

# These two variables belong in the *OpenCode* service environment, not the
# bridge environment. The bundled plugin reads them to call the bridge.
# QQ_BRIDGE_INTERNAL_URL=http://127.0.0.1:8787
# QQ_BRIDGE_INTERNAL_TOKEN=change-me-too

# Used by scripts/e2e-qq.ts. Fill these to run the live QQ smoke test.
# QQ_BOT_ID=
# QQ_PEER_ID=
# QQ_BOT_TOKEN=
# QQ_PEER_TOKEN=
# QQ_BOT_HTTP=http://127.0.0.1:13000
# QQ_PEER_HTTP=http://127.0.0.1:13100

# Optional overrides.
# LOG_LEVEL=info
# LOG_PRETTY=0
